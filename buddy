#!/usr/bin/env python3
"""
Buddy — Modern Extensible Linux Desktop Companion
Targeted for Fedora Linux, GNOME, KDE, Wayland, and X11.
"""

import sys
import os
import argparse
import signal
import socket
import json
from pathlib import Path

# Add project root to sys.path
PROJECT_ROOT = Path(__file__).resolve().parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

# Enforce X11 backend for XWayland cursor polling and input shape transparency
os.environ["GDK_BACKEND"] = "x11"
os.environ["PYTHONUNBUFFERED"] = "1"

from core.config import config, CACHE_DIR
from skins.manager import skin_manager

SOCKET_FILE = CACHE_DIR / "buddy.sock"
PID_FILE = CACHE_DIR / "buddy.pid"
VERSION = "1.0.0"


def send_daemon_command(cmd: dict) -> bool:
    """Send command to running Buddy daemon via Unix socket."""
    if not SOCKET_FILE.exists():
        return False
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.connect(str(SOCKET_FILE))
        client.sendall(json.dumps(cmd).encode("utf-8"))
        client.close()
        return True
    except Exception:
        # Stale socket
        if SOCKET_FILE.exists():
            SOCKET_FILE.unlink()
        return False


def start_ipc_server(engine):
    """Start local Unix socket listener in GLib main loop to receive CLI commands."""
    try:
        if SOCKET_FILE.exists():
            SOCKET_FILE.unlink()
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(SOCKET_FILE))
        server.listen(5)
        server.setblocking(False)

        import gi
        gi.require_version("GLib", "2.0")
        from gi.repository import GLib

        def on_socket_readable(source, condition):
            try:
                conn, _ = server.accept()
                data = conn.recv(1024).decode("utf-8")
                if data:
                    msg = json.loads(data)
                    action = msg.get("action")
                    if action == "pause":
                        engine.paused = True
                    elif action == "resume":
                        engine.paused = False
                    elif action == "toggle_pause":
                        engine.toggle_pause()
                    elif action == "switch_skin":
                        engine.switch_skin(msg.get("skin_id"))
                    elif action == "settings":
                        from ui.settings_dialog import show_settings_dialog
                        show_settings_dialog(engine)
                    elif action == "skins":
                        from ui.skin_selector import show_skin_selector
                        show_skin_selector(engine)
                    elif action == "quit":
                        import gi
                        gi.require_version("Gtk", "3.0")
                        from gi.repository import Gtk
                        Gtk.main_quit()
                conn.close()
            except Exception:
                pass
            return True

        GLib.io_add_watch(server.fileno(), GLib.IO_IN, on_socket_readable)
    except Exception as e:
        print(f"[Buddy IPC] Warning: Could not initialize control socket: {e}")


def main():
    parser = argparse.ArgumentParser(description="Buddy — Your Linux Desktop Companion")
    parser.add_argument("--skin", type=str, help="Launch or switch to specified skin (e.g. thor, dragon, cat, dog, hulk, ironman, harry_potter, captain_america, thanos, batman, superman)")
    parser.add_argument("--pause", action="store_true", help="Pause running Buddy pet")
    parser.add_argument("--resume", action="store_true", help="Resume running Buddy pet")
    parser.add_argument("--settings", action="store_true", help="Open Buddy settings dialog")
    parser.add_argument("--skins", action="store_true", help="Open Buddy character skin gallery")
    parser.add_argument("--list-skins", action="store_true", help="List all available skins to terminal")
    parser.add_argument("--debug", action="store_true", help="Launch with developer diagnostics overlay HUD")
    parser.add_argument("--version", action="store_true", help="Show Buddy version")
    parser.add_argument("--quit", action="store_true", help="Quit running Buddy pet")

    args = parser.parse_args()

    if args.version:
        print(f"Buddy Desktop Pet v{VERSION} (Linux/Fedora)")
        return

    if args.list_skins:
        print("Available Buddy Skins:")
        for s in skin_manager.get_available_skins():
            flight = " [Can Fly]" if s.get("canFly") else ""
            print(f"  • {s['id']:<16} - {s['name']}{flight}: {s['description']}")
        return

    # Check for daemon commands
    if args.pause:
        if send_daemon_command({"action": "pause"}):
            print("Buddy paused.")
            return
        else:
            print("No running Buddy instance found.")
            return

    if args.resume:
        if send_daemon_command({"action": "resume"}):
            print("Buddy resumed.")
            return
        else:
            print("No running Buddy instance found.")
            return

    if args.settings:
        if send_daemon_command({"action": "settings"}):
            return
        # If not running, fall through and run with settings

    if args.skins:
        if send_daemon_command({"action": "skins"}):
            return

    if args.quit:
        if send_daemon_command({"action": "quit"}):
            print("Buddy instance terminated.")
            return
        else:
            print("No running Buddy instance found.")
            return

    if args.skin and send_daemon_command({"action": "switch_skin", "skin_id": args.skin}):
        print(f"Switched running Buddy to skin: {args.skin}")
        return

    # SIGHUP and SIGTERM handling
    if hasattr(signal, "SIGHUP"):
        signal.signal(signal.SIGHUP, signal.SIG_IGN)

    def signal_handler(sig, frame):
        print("\nBuddy says goodbye! Exiting gracefully...", flush=True)
        if SOCKET_FILE.exists():
            try:
                SOCKET_FILE.unlink()
            except Exception:
                pass
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk
        Gtk.main_quit()
        sys.exit(0)

    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)

    # Launch application engine
    from core.engine import BuddyEngine
    from core.tray import BuddyTray

    # Write PID
    try:
        with open(PID_FILE, "w") as f:
            f.write(str(os.getpid()))
    except Exception:
        pass

    engine = BuddyEngine(requested_skin=args.skin, debug_mode=args.debug)
    tray = BuddyTray(engine)
    start_ipc_server(engine)

    print(f"⚡ Buddy Desktop Companion v{VERSION} launched successfully on display!")
    print(f"Active Skin: {engine.character.skin_id.upper()}")
    print("Press Ctrl+C in terminal or right-click pet / tray icon to configure or quit.")

    engine.run()


if __name__ == "__main__":
    main()
