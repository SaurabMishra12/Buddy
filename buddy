#!/usr/bin/env python3
"""
Buddy 2.0 — Modern Extensible Linux Desktop Companion & Productivity Assistant
Targeted for Fedora Linux, GNOME, KDE, Wayland, and X11.
"""

import sys
import os
import argparse
import signal
import socket
import json
from pathlib import Path

# Add project root to sys.path
PROJECT_ROOT = Path(__file__).resolve().parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

# Enforce X11 backend for XWayland cursor polling and input shape transparency
os.environ["GDK_BACKEND"] = "x11"
os.environ["PYTHONUNBUFFERED"] = "1"

from core.config import config, CACHE_DIR
from skins.manager import skin_manager
from pomodoro.statistics import PomodoroStats

SOCKET_FILE = CACHE_DIR / "buddy.sock"
PID_FILE = CACHE_DIR / "buddy.pid"
VERSION = "2.0.0"


def send_daemon_command(cmd: dict) -> bool:
    """Send command to running Buddy daemon via Unix socket."""
    if not SOCKET_FILE.exists():
        return False
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.connect(str(SOCKET_FILE))
        client.sendall(json.dumps(cmd).encode("utf-8"))
        client.close()
        return True
    except Exception:
        if SOCKET_FILE.exists():
            SOCKET_FILE.unlink()
        return False


def start_ipc_server(engine):
    """Start local Unix socket listener in GLib main loop to receive CLI commands."""
    try:
        if SOCKET_FILE.exists():
            SOCKET_FILE.unlink()
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(SOCKET_FILE))
        server.listen(5)
        server.setblocking(False)

        import gi
        gi.require_version("GLib", "2.0")
        from gi.repository import GLib

        def on_socket_readable(source, condition):
            try:
                conn, _ = server.accept()
                data = conn.recv(1024).decode("utf-8")
                if data:
                    msg = json.loads(data)
                    action = msg.get("action")
                    if action == "pause":
                        engine.paused = True
                    elif action == "resume":
                        engine.paused = False
                    elif action == "toggle_pause":
                        engine.toggle_pause()
                    elif action == "switch_skin":
                        skin_id = msg.get("skin_id")
                        if skin_id:
                            engine.switch_skin(skin_id)
                    elif action == "settings":
                        from ui.settings_dialog import show_settings_dialog
                        show_settings_dialog(engine)
                    elif action in ("skins", "skin_gallery"):
                        from ui.skin_selector import show_skin_selector
                        show_skin_selector(engine)
                    elif action == "stats":
                        from ui.stats_dialog import show_stats_dialog
                        show_stats_dialog(engine)
                    elif action == "pomodoro":
                        sub = msg.get("sub", "start")
                        pomo = getattr(engine, "pomodoro", None)
                        if pomo:
                            if sub == "start":
                                pomo.start_work()
                            elif sub == "pause":
                                pomo.pause()
                            elif sub == "resume":
                                pomo.resume()
                            elif sub == "reset":
                                pomo.reset()
                            elif sub == "skip":
                                pomo.skip()
                    elif action == "quit":
                        import gi
                        gi.require_version("Gtk", "3.0")
                        from gi.repository import Gtk
                        Gtk.main_quit()
                conn.close()
            except Exception:
                pass
            return True

        GLib.io_add_watch(server.fileno(), GLib.IO_IN, on_socket_readable)
    except Exception as e:
        print(f"[Buddy IPC] Warning: Could not initialize control socket: {e}")


def main():
    parser = argparse.ArgumentParser(description="Buddy 2.0 — Your Linux Desktop Companion & Productivity Assistant")
    parser.add_argument("--skin", type=str, help="Launch or switch to specified skin (e.g. thor, dragon, cat, dog, slime, fox, ninja, space_robot...)")
    parser.add_argument("--pause", action="store_true", help="Pause running Buddy companion")
    parser.add_argument("--resume", action="store_true", help="Resume running Buddy companion")
    parser.add_argument("--settings", action="store_true", help="Open Buddy multi-section settings dialog")
    parser.add_argument("--skins", "--skin-gallery", action="store_true", dest="skins", help="Open Buddy visual character skin gallery")
    parser.add_argument("--list-skins", action="store_true", help="List all 20+ available skins to terminal")
    parser.add_argument("--pomodoro", nargs="?", const="start", choices=["start", "pause", "resume", "reset", "skip", "status"], help="Pomodoro productivity controls (start, pause, resume, reset, skip, status)")
    parser.add_argument("--stats", action="store_true", help="Show productivity and focus session statistics")
    parser.add_argument("--debug", action="store_true", help="Launch with developer diagnostics overlay HUD")
    parser.add_argument("--version", action="store_true", help="Show Buddy version")
    parser.add_argument("--quit", action="store_true", help="Quit running Buddy instance")

    args = parser.parse_args()

    if args.version:
        print(f"Buddy Desktop Companion v{VERSION} (Linux/Fedora/GNOME/KDE)")
        return

    if args.list_skins:
        print("⚡ Available Buddy 2.0 Characters:")
        for s in skin_manager.get_available_skins():
            flight = " [Can Fly]" if s.get("canFly") else ""
            cat = f"({s.get('category', 'general').capitalize()})"
            print(f"  • {s['id']:<16} {cat:<10} - {s['name']}{flight}: {s['description']}")
        return

    if args.stats:
        stats = PomodoroStats()
        summary = stats.get_summary()
        today_mins = stats.sessions_today * 25.0
        h = int(today_mins // 60)
        m = int(today_mins % 60)
        t_str = f"{h}h {m}m" if h > 0 else f"{m}m"
        print("📊 Buddy 2.0 Productivity Statistics:")
        print(f"  • Today's Focus:     {t_str}")
        print(f"  • Sessions Today:    {stats.sessions_today}")
        print(f"  • Sessions Week:     {stats.sessions_this_week}")
        print(f"  • Current Streak:    {stats.streak_days} days")
        print(f"  • Total Lifetime:    {summary['total_focus_hours']} hours")
        if send_daemon_command({"action": "stats"}):
            print("  (Opened visual statistics dashboard on desktop)")
        return

    if args.pomodoro:
        sub = args.pomodoro
        if send_daemon_command({"action": "pomodoro", "sub": sub}):
            print(f"🍅 Sent Pomodoro command: {sub.upper()} to running Buddy.")
            return
        else:
            print(f"No running Buddy instance found to execute Pomodoro '{sub}'. Launching Buddy with Pomodoro...")

    # Check for daemon commands
    if args.pause:
        if send_daemon_command({"action": "pause"}):
            print("Buddy paused.")
            return
        else:
            print("No running Buddy instance found.")
            return

    if args.resume:
        if send_daemon_command({"action": "resume"}):
            print("Buddy resumed.")
            return
        else:
            print("No running Buddy instance found.")
            return

    if args.settings:
        if send_daemon_command({"action": "settings"}):
            return

    if args.skins:
        if send_daemon_command({"action": "skins"}):
            return

    if args.quit:
        if send_daemon_command({"action": "quit"}):
            print("Buddy instance terminated.")
            return
        else:
            print("No running Buddy instance found.")
            return

    target_skin = skin_manager.normalize_skin_id(args.skin) if args.skin else None

    if target_skin and send_daemon_command({"action": "switch_skin", "skin_id": target_skin}):
        print(f"⚡ Switched running Buddy to skin: {target_skin.upper()}")
        return

    # If already running without extra args, open skins gallery dialog
    if not target_skin and not args.pause and not args.resume and not args.settings and not args.skins and not args.quit and not args.pomodoro:
        if send_daemon_command({"action": "skins"}):
            print("⚡ Buddy is already running on desktop! Opened Character Skin Gallery.")
            return

    # Clean up stale previous process if socket was dead but process hung
    if PID_FILE.exists():
        try:
            import time
            old_pid = int(PID_FILE.read_text().strip())
            os.kill(old_pid, 0)
            print(f"Cleaning up previous Buddy process (PID {old_pid})...")
            os.kill(old_pid, signal.SIGTERM)
            time.sleep(0.3)
        except Exception:
            pass

    # SIGHUP and SIGTERM handling
    if hasattr(signal, "SIGHUP"):
        signal.signal(signal.SIGHUP, signal.SIG_IGN)

    def _cleanup_files():
        for f in (SOCKET_FILE, PID_FILE):
            try:
                if f.exists():
                    f.unlink()
            except Exception:
                pass

    def signal_handler(sig, frame):
        print("\nBuddy says goodbye! Exiting gracefully...", flush=True)
        _cleanup_files()
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk
        if Gtk.main_level() > 0:
            Gtk.main_quit()

    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)

    # Launch application engine
    from core.engine import BuddyEngine
    from core.tray import BuddyTray

    # Write PID
    try:
        with open(PID_FILE, "w") as f:
            f.write(str(os.getpid()))
    except Exception:
        pass

    engine = BuddyEngine(requested_skin=args.skin, debug_mode=args.debug)
    tray = BuddyTray(engine)
    start_ipc_server(engine)

    if args.pomodoro == "start":
        engine.pomodoro.start_work()

    print(f"⚡ Buddy Desktop Companion v{VERSION} launched successfully on display!")
    print(f"Active Skin: {engine.character.skin_id.upper()}")
    print("Press Ctrl+C in terminal or right-click pet / tray icon to configure or quit.")

    engine.run()

    # Clean up on normal exit
    _cleanup_files()


if __name__ == "__main__":
    main()
